PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=gpe
EMAIL_REMETENTE=seu_email@gmail.com
SENHA_APP=sua_senha_de_aplicativo
JWT_SECRET=troque_para_um_segredo_forte
JWT_EXPIRES_IN=15m
REFRESH_SECRET=troque_para_outro_segredo_forte
REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5500

# ── Worker de e-mail (opcionais; defaults explicados em src/config/emailConfig.js) ──
# EMAIL_WORKER_INLINE=true            # false = não roda no server; use "npm run worker"
# EMAIL_MAX_RETRIES=4                 # retries após a 1ª tentativa (5 tentativas no total)
# EMAIL_RETRY_BASE_DELAY_MS=30000     # backoff: 30s, 1min, 2min, 4min...
# EMAIL_RETRY_MAX_DELAY_MS=900000     # teto do backoff (15 min)
# EMAIL_RETRY_JITTER_RATIO=0.2
# EMAIL_WORKER_CONCURRENCY=5
# EMAIL_WORKER_BATCH_SIZE=20
# EMAIL_WORKER_POLL_INTERVAL_MS=5000
# EMAIL_PROCESSING_TIMEOUT_MS=300000  # PROCESSING órfão volta para a fila após 5 min
# SMTP_POOL=true
# SMTP_MAX_CONNECTIONS=5
# SMTP_MAX_MESSAGES=100
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=30000

# ── Notificações via WhatsApp (Entrega 4; defaults em src/config/whatsappConfig.js) ──
# WHATSAPP_ENABLED=false              # true = ativa enfileiramento e worker de WhatsApp
# WHATSAPP_PROVIDER=waha              # waha | fake | evolution | meta
# WHATSAPP_WORKER_INLINE=true         # false = não roda no server; use "npm run worker:whatsapp"
# WHATSAPP_JANELA_CORRECAO_MIN=15     # minutos antes do envio (permite corrigir falta -> presente)
# WHATSAPP_HORARIO_SILENCIO=21:00-07:00
# WHATSAPP_VERIFY_TOKEN=segredo_webhook
# APP_PUBLIC_URL=http://localhost:5500
# ESCOLA_NOME=GPE
#
# # WAHA (WhatsApp HTTP API — pasta waha-core, quando WHATSAPP_PROVIDER=waha)
# WAHA_URL=http://localhost:3001
# WAHA_API_KEY=troque_por_uma_chave_aleatoria   # mesma de waha-core/.env (gere com: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))")
# WAHA_SESSION=default
# WAHA_HMAC_SECRET=                   # se definido, o webhook EXIGE X-Webhook-Hmac (configure WHATSAPP_HOOK_HMAC_KEY igual no waha-core)
# WAHA_CHECK_NUMBER_EXISTS=true
# WHATSAPP_DEV_REPROCESSAR_HOJE=false # dev: no boot, recoloca na fila jobs de hoje em RETRY/FAILED/fake
#
# # Meta Cloud API (quando WHATSAPP_PROVIDER=meta)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_VERSION=v21.0
# WHATSAPP_TEMPLATE_LANG=pt_BR
#
# # Evolution API (quando WHATSAPP_PROVIDER=evolution)
# EVOLUTION_URL=http://localhost:8080
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=gpe

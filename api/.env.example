PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=gpe
EMAIL_REMETENTE=seu_email@gmail.com
SENHA_APP=sua_senha_de_aplicativo
JWT_SECRET=troque_para_um_segredo_forte
JWT_EXPIRES_IN=15m
REFRESH_SECRET=troque_para_outro_segredo_forte
REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5500

# ── Worker de e-mail (opcionais; defaults explicados em src/config/emailConfig.js) ──
# EMAIL_WORKER_INLINE=true            # false = não roda no server; use "npm run worker"
# EMAIL_MAX_RETRIES=4                 # retries após a 1ª tentativa (5 tentativas no total)
# EMAIL_RETRY_BASE_DELAY_MS=30000     # backoff: 30s, 1min, 2min, 4min...
# EMAIL_RETRY_MAX_DELAY_MS=900000     # teto do backoff (15 min)
# EMAIL_RETRY_JITTER_RATIO=0.2
# EMAIL_WORKER_CONCURRENCY=5
# EMAIL_WORKER_BATCH_SIZE=20
# EMAIL_WORKER_POLL_INTERVAL_MS=5000
# EMAIL_PROCESSING_TIMEOUT_MS=300000  # PROCESSING órfão volta para a fila após 5 min
# SMTP_POOL=true
# SMTP_MAX_CONNECTIONS=5
# SMTP_MAX_MESSAGES=100
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=30000